#!/command/with-contenv bashio
# ==============================================================================
# Arret de nginx. Sans nginx, l'add-on n'a plus aucun point d'entree : on arrete
# le conteneur au lieu de le laisser tourner sans interface.
# ==============================================================================
declare exit_code_container
declare exit_code_service="${1}"
declare exit_code_signal="${2}"

exit_code_container=$(bashio::jq "/run/s6-linux-init-container-results/exit" "")

bashio::log.info "Arret du service nginx..."

if [[ "${exit_code_service}" -eq 256 ]]; then
    if [[ "${exit_code_container}" == "" ]]; then
        echo $((128 + exit_code_signal)) > /run/s6-linux-init-container-results/exit
    fi
    [[ "${exit_code_signal}" -eq 15 ]] && exec /run/s6/basedir/bin/halt
elif [[ "${exit_code_service}" -ne 0 ]]; then
    if [[ "${exit_code_container}" == "" ]]; then
        echo "${exit_code_service}" > /run/s6-linux-init-container-results/exit
    fi
    exec /run/s6/basedir/bin/halt
fi
