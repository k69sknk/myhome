#!/command/with-contenv bashio
# ==============================================================================
# nginx : filtrage d'adresse IP pour l'ingress et service des assets statiques.
# Demarre apres mabarak-api (dependance s6), pour ne jamais servir
# l'interface avant que l'API soit joignable.
# ==============================================================================

bashio::log.info "Demarrage de nginx sur le port d'ingress 8099..."

exec nginx -c /etc/nginx/nginx.conf
